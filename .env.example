# Đổi trước khi deploy public
ADMIN_EMAIL=admin@motionhub.local
ADMIN_PASSWORD=ChangeMe123!
WORKER_TOKEN=change-worker-token

# Test-only Google signup balance. Existing accounts are never reset on login.
TEST_MODE=false
TEST_INITIAL_CREDITS=100

# Render lifecycle. Use mock only for explicit local/test runs; production uses worker.
RENDER_MODE=worker
MOCK_VIDEO_DURATION=5
WORKER_UNAVAILABLE_TIMEOUT_SECONDS=300
WORKER_HEARTBEAT_TIMEOUT_SECONDS=90
JOB_RENDER_TIMEOUT_SECONDS=1800
JOB_RECONCILE_INTERVAL_SECONDS=30

# Phase 4B GPU backend bridge (server-side only)
GPU_BACKEND_ENABLED=false
GPU_API_BASE_URL=
GPU_API_SERVICE_TOKEN=
GPU_API_CONNECT_TIMEOUT_SECONDS=
GPU_API_READ_TIMEOUT_SECONDS=

# Independent GPU workers for the four API-ready services
VIDEO_WORKER_URL=
VIDEO_WORKER_TOKEN=
OUTFIT_WORKER_URL=
OUTFIT_WORKER_TOKEN=
BACKGROUND_WORKER_URL=
BACKGROUND_WORKER_TOKEN=
UPSCALE_WORKER_URL=
UPSCALE_WORKER_TOKEN=
WORKER_REQUEST_TIMEOUT=30
WORKER_POLL_INTERVAL=4

# Model capabilities and usage. Leave VIDEO_USAGE_COST empty until pricing is known.
VIDEO_USAGE_COST=1
VIDEO_ALLOWED_DURATIONS=5,10
UPSCALE_ALLOWED_SCALES=2,4
UPSCALE_FACE_RESTORE_SUPPORTED=false

# Local is development-only. Configure a durable adapter before production/Railway.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=

# Model registry (identifiers are deployment configuration, not adapter constants)
MOTION_STUDIO_MODELS=wan-animate-2,scail-2
VIDEO_MODEL=wan22-start-end
MOTION_GPU_MODEL=wan-animate-2
MOTION_GPU_OPERATION=motion-transfer-video
OUTFIT_MODEL=flux-2-klein-4b
BACKGROUND_MASK_MODEL=
BACKGROUND_MODEL=flux-2-klein-4b
UPSCALE_MODEL=real-esrgan

# Best-effort internal post-processing for Motion Studio and AI Video Creator
VIDEO_UPSCALE_ENABLED=true
VIDEO_UPSCALE_WORKER_URL=
VIDEO_UPSCALE_WORKER_TOKEN=
VIDEO_UPSCALE_MODEL=seedvr2-3b-fp8
VIDEO_UPSCALE_TARGET_SHORT_SIDE=1080
VIDEO_UPSCALE_TIMEOUT=
